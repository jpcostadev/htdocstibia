{% if players is iterable %}
  <div class="col-lg-4 col-12">
    <div class="box">
      <div class="box-header">
        <h3 class="box-title">Últimos 10 acessos</h3>
      </div>
      <div class="box-body no-padding">
        <table class="table table-condensed">
          <tbody>
          <tr>
            <th>#</th>
            <th>Personagem</th>
            <th>Data do acesso</th>
          </tr>
          {% set i = 0 %}
          {% for result in players %}
            {% set i = i + 1 %}
            <tr>
              <td>{{ i }}</td>
              <td>{{ result.name }}</td>
              <td>{{ result.lastlogin|date("d/m/Y H:i:s") }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
{% endif %}
