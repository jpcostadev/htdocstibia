<main class="rf-server-info">
  <section class="rf-info-section rf-general-info">
    <h2><span aria-hidden="true">▣</span> INFORMAÇÕES GERAIS</h2>
    <div class="rf-info-copy">
      <p>O server save diário ocorre às <strong>{{ serverSave.0 }}:{{ serverSave.1 }} (Horário de Brasília).</strong></p>
      <p>Consulte abaixo as taxas e configurações oficiais do Renfall.</p>
    </div>
  </section>
  <section class="rf-info-section">
    <h2><span aria-hidden="true">☆</span> TAXAS DO SERVIDOR</h2>
    <div class="rf-rates-wrap">
      {% if rateUseStages and rateStages.experienceStages is defined %}
        <table class="rf-rate-table"><tbody>
          <tr><th class="rf-rate-kind"></th><th>Do Level</th><th>Até Level</th><th>Multiplicador</th></tr>
          {% for result in rateStages.experienceStages %}<tr>{% if loop.first %}<td class="rf-rate-kind" rowspan="{{ rateStages.experienceStages|length }}">Experience</td>{% endif %}<td>{{ result.minlevel }}</td><td>{{ result.maxlevel is not empty ? result.maxlevel : '∞' }}</td><td>{{ result.multiplier }}x</td></tr>{% endfor %}
        </tbody></table>
        <table class="rf-rate-table"><tbody>
          <tr><th class="rf-rate-kind"></th><th>Do Skill</th><th>Até Skill</th><th>Multiplicador</th></tr>
          {% for result in rateStages.skillsStages %}<tr>{% if loop.first %}<td class="rf-rate-kind" rowspan="{{ rateStages.skillsStages|length }}">Skill</td>{% endif %}<td>{{ result.minlevel }}</td><td>{{ result.maxlevel is not empty ? result.maxlevel : '∞' }}</td><td>{{ result.multiplier }}x</td></tr>{% endfor %}
        </tbody></table>
        <table class="rf-rate-table"><tbody>
          <tr><th class="rf-rate-kind"></th><th>Do Magic</th><th>Até Magic</th><th>Multiplicador</th></tr>
          {% for result in rateStages.magicLevelStages %}<tr>{% if loop.first %}<td class="rf-rate-kind" rowspan="{{ rateStages.magicLevelStages|length }}">Magic</td>{% endif %}<td>{{ result.minlevel }}</td><td>{{ result.maxlevel is not empty ? result.maxlevel : '∞' }}</td><td>{{ result.multiplier }}x</td></tr>{% endfor %}
        </tbody></table>
      {% else %}
        <table class="rf-rate-table"><tbody><tr><th>Experiência</th><th>Skill</th><th>Magic</th></tr><tr><td>{{ rateExp }}x</td><td>{{ rateSkill }}x</td><td>{{ rateMagic }}x</td></tr></tbody></table>
      {% endif %}
    </div>
  </section>
  <div class="rf-info-grid">
    <section class="rf-info-section"><h2>CASAS</h2><div class="rf-info-list"><p><strong>Level mínimo:</strong> {{ houseLevel }}</p><p><strong>Aluguel:</strong> {{ houseRent }}</p></div></section>
    <section class="rf-info-section"><h2>CONFIGURAÇÕES</h2><div class="rf-info-list"><p><strong>Protection level:</strong> {{ protectionLevel }}</p><p><strong>Loot:</strong> {{ rateLoot }}x</p><p><strong>Spawn:</strong> {{ rateSpawn }}x</p></div></section>
    <section class="rf-info-section"><h2>FRAGS E SKULLS</h2><div class="rf-info-list"><p><strong>Red Skull:</strong> {{ dailyFragsToRedSkull }} diária / {{ weeklyFragsToRedSkull }} semanal / {{ monthlyFragsToRedSkull }} mensal</p><p><strong>Black Skull:</strong> {{ dailyFragsToRedSkull * 2 }} diária / {{ weeklyFragsToRedSkull * 2 }} semanal / {{ monthlyFragsToRedSkull * 2 }} mensal</p></div></section>
  </div>
</main>
