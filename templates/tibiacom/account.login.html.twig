<section class="rf-auth-card">
  <h2>ENTRAR NA CONTA</h2>
  <form class="rf-auth-form" action="{{ getLink('account/manage') }}" method="post">
    {% if redirect is not null %}<input type="hidden" name="redirect" value="{{ redirect }}">{% endif %}
    <input type="hidden" name="page" value="overview">
    <label for="rf-account-login">{{ account_login_by }}</label>
    <input id="rf-account-login" type="text" name="account_login" maxlength="30" autocomplete="username" autofocus>
    <label for="rf-password-login">Senha</label>
    <input id="rf-password-login" type="password" name="password_login" maxlength="29" autocomplete="current-password">
    <label class="rf-remember" for="remember_me"><input type="checkbox" id="remember_me" name="remember_me" value="true"> Manter conectado</label>
    <button class="rf-auth-primary" type="submit">ENTRAR</button>
  </form>
  <a class="rf-auth-lost" href="{{ getLink('account/lost') }}">Esqueci minha senha</a>
</section>

<section class="rf-auth-card rf-new-player">
  <h2>NOVO NO {{ config.lua.serverName|upper }}?</h2>
  <div class="rf-new-player-content">
    <div><h3>Bem-vindo ao {{ config.lua.serverName }}!</h3><p>Um mundo vivo para quem busca grandes aventuras.</p><p>Enfrente desafios, evolua e conquiste seu lugar.</p><p>Faça aliados e escreva a sua própria história.</p></div>
    <a class="rf-auth-primary" href="{{ getLink('account/create') }}">CRIAR CONTA</a>
  </div>
</section>
